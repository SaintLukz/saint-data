55,558,543],"avg":[null,null,157.88095238095238,229.16904761904757,302.3082706766917,337.6097883597884,327.0857142857143,272.3333333333333,270.35714285714283,275,295.14285714285717,298.2857142857143,221,247.2777777777778,265.3025210084033,273.95,306.6428571428571,277.10714285714283,284.8469387755102,342.15816326530614,405.2063492063492,438.76984126984127,492.0238095238096],"cnt":[null,null,6,20,19,18,5,3,4,2,6,3,1,6,17,10,4,8,14,14,18,18,6]},"vh":{"t0":1794502800000,"v":[3307926,3309472,3311123,3312531,3313787,3314771,3315464,null,null,null,null,null,null,3318307,3319081,3320106,3321093,3322242,3323699,3325125,3326497,3327670,3328850,3330075,3331235,3332479,3333719,3334886,3336073,3337192,3338054,null,null,null,null,null,null,null,null,3343045,3344127,3345200,3346368,3347565,null,null,null,null,null,3353803]},"desc":"🎯 مرحباً بك في أكاديمية بلانتوم العسكرية 🎯\n\nهل تمتلك الانضباط والطموح لتصبح أحد أفراد أكاديمية بلانتوم؟ 🎖️\n\nانضم إلى تجربة محاكاة عسكرية مليئة بالتدريب والتحديات والعمل الجماعي! طوّر مهاراتك، اجتز التدريبات، واجمع النقاط لتتقدم في الرتب وتصل إلى مستويات أعلى داخل الأكاديمية.\n\n🌟 ماذا ينتظرك داخل أكاديمية بلانتوم؟\n\n🎖️ نظام رتب وتقدم\nابدأ رحلتك كعضو جديد، شارك في الأنشطة والتدريبات، واجمع النقاط لفتح رتب ومهام جديدة.\n\n💪 تدريبات وتحديات متنوعة\nاختبر سرعتك وتركيزك في مجموعة من التحديات والأنشطة الميدانية الممتعة.\n\n📜 مهام وأنشطة جماعية\nشارك مع أصدقائك في مهام متنوعة تعتمد على التعاون والتنظيم والالتزام بالتعليمات.\n\n🛡️ تخصصات متعددة\nاكتشف مجالات مختلفة داخل الأكاديمية، وطور مهاراتك للوصول إلى مستويات متقدمة.\n\n🏆 تقدم ونافس\nاجمع النقاط، ارفع رتبتك، واثبت جدارتك للوصول إلى أعلى المستويات.\n\n🚀 هل أنت مستعد لبدء رحلتك؟\nانضم إلى أكاديمية بلانتوم وابدأ مسيرتك اليوم! 🎖️\n\nعسكرية، عسكر، جيش، جنود، عرب، عربي، معسكر، تدريب عسكري، أكاديمية عسكرية، رول بلاي، تمثيل أدوار، رتب، ضباط، شرطة، بلانتوم،","thumbs":["https://tr.rbxcdn.com/180DAY-56936143b6663a2b6ba5fddad7ea6c91/768/432/Image/Webp/noFilter"]}