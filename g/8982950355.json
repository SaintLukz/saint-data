5238,229.16904761904757,302.3082706766917,337.6097883597884,327.0857142857143,272.3333333333333,270.35714285714283,275,295.14285714285717,298.2857142857143,221,247.2777777777778,265.3025210084033,273.95,306.6428571428571],"cnt":[null,null,6,20,19,18,5,3,4,2,6,3,1,6,17,10,4]},"vh":{"t0":1793876400000,"v":[3207219,3208043,3208766,3209404,3210122,3210846,3211642,3212421,3213146,3213853,3214452,3214915,null,null,null,null,null,null,null,null,3216799,3217351,3217988,3218535,3219225,3219941,3220606,null,null,null,null,null,3224266,3224847,3225374,null,null,null,null,null,null,null,null,null,null,null,3229536,3230295,3231117,3231910]},"desc":"🎯 مرحباً بك في أكاديمية بلانتوم العسكرية 🎯\n\nهل تمتلك الانضباط والطموح لتصبح أحد أفراد أكاديمية بلانتوم؟ 🎖️\n\nانضم إلى تجربة محاكاة عسكرية مليئة بالتدريب والتحديات والعمل الجماعي! طوّر مهاراتك، اجتز التدريبات، واجمع النقاط لتتقدم في الرتب وتصل إلى مستويات أعلى داخل الأكاديمية.\n\n🌟 ماذا ينتظرك داخل أكاديمية بلانتوم؟\n\n🎖️ نظام رتب وتقدم\nابدأ رحلتك كعضو جديد، شارك في الأنشطة والتدريبات، واجمع النقاط لفتح رتب ومهام جديدة.\n\n💪 تدريبات وتحديات متنوعة\nاختبر سرعتك وتركيزك في مجموعة من التحديات والأنشطة الميدانية الممتعة.\n\n📜 مهام وأنشطة جماعية\nشارك مع أصدقائك في مهام متنوعة تعتمد على التعاون والتنظيم والالتزام بالتعليمات.\n\n🛡️ تخصصات متعددة\nاكتشف مجالات مختلفة داخل الأكاديمية، وطور مهاراتك للوصول إلى مستويات متقدمة.\n\n🏆 تقدم ونافس\nاجمع النقاط، ارفع رتبتك، واثبت جدارتك للوصول إلى أعلى المستويات.\n\n🚀 هل أنت مستعد لبدء رحلتك؟\nانضم إلى أكاديمية بلانتوم وابدأ مسيرتك اليوم! 🎖️\n","thumbs":["https://tr.rbxcdn.com/180DAY-dc71a61c4b53dd903b1169f29b1283c2/768/432/Image/Webp/noFilter","https://tr.rbxcdn.com/180DAY-08a25a940403897c8f9a85a6f179b57e/768/432/Image/Webp/noFilter","https://tr.rbxcdn.com/180DAY-7113b6c3b82710ba08ca74f98ee2d62e/768/432/Image/Webp/noFilter"]}